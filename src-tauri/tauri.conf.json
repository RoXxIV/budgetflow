{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetFlow2",
  "version": "2.0.1",
  "identifier": "fr.revaw.budgetflow2",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["backend/**/*", "seed/*"],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      }
    }
  }
}
