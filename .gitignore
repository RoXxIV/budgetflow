src-tauri/seed/

# ─── Secrets / config locale ─────────────────
.env
.env.*
!.env.example
*.local

# ─── Logs ────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Éditeurs / OS ───────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Divers ──────────────────────────────────
*.tsbuildinfo
.eslintcache
*.timestamp-*-*.mjs

# ─── Base SQLite locale (données réelles, jamais versionnées) ───
backend/data/
