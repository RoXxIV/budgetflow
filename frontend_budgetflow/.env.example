# Copier en .env.development.local (ignoré par git, chargé uniquement par `npm run dev`).
#
# URL du backend en dev. Par défaut le frontend vise http://localhost:3001/api,
# le port du backend embarqué dans l'app Tauri. Surcharger pour faire tourner
# un backend de dev sur un autre port (ex. 3002 avec une base de travail).
#
# Attention : `npm run tauri:dev` lance aussi Vite en mode development et lira
# ce fichier — le sidecar, lui, écoute toujours sur le port compilé (3001).
VITE_API_URL=http://localhost:3002/api
